---
---

<div
  class="fixed inset-0 pointer-events-none overflow-hidden z-0 select-none"
  aria-hidden="true"
  id="lunar-monowire-bg"
>

  <svg
    id="lunar-moon-svg"
    class="absolute -top-24 -right-24 h-[520px] w-[520px] opacity-35 transition-all duration-500 dark:opacity-45 sm:h-[640px] sm:w-[640px]"
    viewBox="0 0 600 600"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="lunaGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--pink)" stop-opacity="0.24" />
        <stop offset="55%" stop-color="var(--cyan)" stop-opacity="0.08" />
        <stop offset="100%" stop-color="transparent" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="crescentGrad" x1="200" y1="160" x2="420" y2="400" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0.45" />
        <stop offset="100%" stop-color="var(--pink)" stop-opacity="0.55" />
      </linearGradient>
    </defs>
    <circle cx="320" cy="270" r="240" fill="url(#lunaGlow)" />
    <circle cx="320" cy="270" r="195" stroke="var(--cyan)" stroke-opacity="0.16" stroke-width="1" stroke-dasharray="6 8" />
    <circle cx="320" cy="270" r="145" stroke="var(--pink)" stroke-opacity="0.22" stroke-width="1" />
    <path
      d="M342 158A112 112 0 1 0 434 316A88 88 0 1 1 342 158Z"
      fill="url(#crescentGrad)"
    />
    <line x1="100" y1="270" x2="540" y2="270" stroke="var(--cyan)" stroke-opacity="0.1" stroke-width="1" />
    <line x1="320" y1="50" x2="320" y2="490" stroke="var(--cyan)" stroke-opacity="0.1" stroke-width="1" />
  </svg>

  <svg
    class="absolute inset-x-0 bottom-0 h-[38vh] w-full opacity-30 dark:opacity-45"
    viewBox="0 0 1440 360"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="horizonFade" x1="0" y1="0" x2="0" y2="360" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="var(--cyan)" stop-opacity="0" />
        <stop offset="30%" stop-color="var(--cyan)" stop-opacity="0.35" />
        <stop offset="100%" stop-color="var(--pink)" stop-opacity="0.25" />
      </linearGradient>
      <linearGradient id="horizonBeam" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="transparent" />
        <stop offset="30%" stop-color="var(--pink)" stop-opacity="0.5" />
        <stop offset="70%" stop-color="var(--cyan)" stop-opacity="0.5" />
        <stop offset="100%" stop-color="transparent" />
      </linearGradient>
    </defs>

    <line x1="0" y1="60" x2="1440" y2="60" stroke="url(#horizonBeam)" stroke-width="1.2" />
    <line x1="0" y1="88" x2="1440" y2="88" stroke="url(#horizonFade)" stroke-width="0.8" />
    <line x1="0" y1="124" x2="1440" y2="124" stroke="url(#horizonFade)" stroke-width="0.8" />
    <line x1="0" y1="170" x2="1440" y2="170" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="0" y1="228" x2="1440" y2="228" stroke="url(#horizonFade)" stroke-width="1" />
    <line x1="0" y1="300" x2="1440" y2="300" stroke="url(#horizonFade)" stroke-width="1.1" />

    <line x1="720" y1="60" x2="-240" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="0" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="240" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="480" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="720" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="960" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="1200" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="1440" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
    <line x1="720" y1="60" x2="1680" y2="360" stroke="url(#horizonFade)" stroke-width="0.9" />
  </svg>

  <canvas id="monowire-canvas" class="absolute inset-0 h-full w-full"></canvas>
</div>

<script is:inline>
  (() => {
    if (window.__monowireInit) return;
    window.__monowireInit = true;

    const canvas = document.getElementById('monowire-canvas');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const mouse = { x: -9999, y: -9999, active: false };
    const slashes = [];
    const stars = [];

    const strands = [
      { y1: 0.16, y2: 0.42, amp: 38, speed: 0.00055, phase: 0.3, colorKey: 'pink', alpha: 0.34, width: 1.3 },
      { y1: 0.28, y2: 0.14, amp: 32, speed: 0.00042, phase: 2.1, colorKey: 'cyan', alpha: 0.32, width: 1.2 },
      { y1: 0.62, y2: 0.78, amp: 44, speed: 0.00048, phase: 4.0, colorKey: 'pink', alpha: 0.24, width: 1.1 },
      { y1: 0.76, y2: 0.54, amp: 36, speed: 0.00038, phase: 1.2, colorKey: 'cyan', alpha: 0.26, width: 1.2 },
    ];

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function getPalette() {
      const isLight = document.documentElement.classList.contains('light');
      return isLight
        ? { pink: '224, 18, 107', cyan: '0, 140, 168', glow: 0.6 }
        : { pink: '255, 42, 133', cyan: '0, 240, 255', glow: 1 };
    }

    function draw(now) {
      ctx.clearRect(0, 0, width, height);
      const pal = getPalette();

      for (const s of strands) {
        const t = reducedMotion ? 0 : now * s.speed + s.phase;
        const startY = height * s.y1;
        const endY = height * s.y2;

        let cp1x = width * 0.33;
        let cp1y = startY + Math.sin(t) * s.amp;
        let cp2x = width * 0.68;
        let cp2y = endY + Math.cos(t * 0.85) * s.amp;

        let boost = 0;
        if (mouse.active) {
          const midY = (startY + endY) * 0.5;
          const distY = Math.abs(mouse.y - midY);
          if (distY < 260) {
            const pull = (1 - distY / 260) * 58;
            const dir = mouse.y > midY ? 1 : -1;
            cp1y += dir * pull * (1 - Math.abs(mouse.x / width - 0.33));
            cp2y += dir * pull * (1 - Math.abs(mouse.x / width - 0.68));
            boost = (1 - distY / 260) * 0.35;
          }
        }

        const rgb = pal[s.colorKey];
        const alpha = Math.min(0.85, (s.alpha + boost) * pal.glow);

        ctx.save();
        ctx.beginPath();
        ctx.moveTo(-20, startY);
        ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, width + 20, endY);
        ctx.strokeStyle = `rgba(${rgb}, ${alpha})`;
        ctx.lineWidth = s.width + boost * 1.1;
        if (boost > 0.05) {
          ctx.shadowColor = `rgba(${rgb}, 0.75)`;
          ctx.shadowBlur = 12;
        }
        ctx.stroke();
        ctx.restore();
      }

      for (let i = slashes.length - 1; i >= 0; i--) {
        const sl = slashes[i];
        const age = (now - sl.born) / sl.life;
        if (age >= 1) {
          slashes.splice(i, 1);
          continue;
        }
        const alpha = (1 - age) * 0.9;
        const len = sl.len * (0.45 + age * 0.75);
        const dx = Math.cos(sl.angle) * len;
        const dy = Math.sin(sl.angle) * len;

        ctx.save();
        const grad = ctx.createLinearGradient(sl.x - dx, sl.y - dy, sl.x + dx, sl.y + dy);
        grad.addColorStop(0, `rgba(${pal.cyan}, 0)`);
        grad.addColorStop(0.5, `rgba(${pal.pink}, ${alpha})`);
        grad.addColorStop(1, `rgba(${pal.cyan}, 0)`);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 2.2 * (1 - age * 0.6);
        ctx.shadowColor = `rgba(${pal.pink}, 0.85)`;
        ctx.shadowBlur = 14;
        ctx.beginPath();
        ctx.moveTo(sl.x - dx, sl.y - dy);
        ctx.quadraticCurveTo(sl.x, sl.y + sl.curve, sl.x + dx, sl.y + dy);
        ctx.stroke();
        ctx.restore();
      }

      for (let i = stars.length - 1; i >= 0; i--) {
        const st = stars[i];
        const age = (now - st.born) / st.life;
        if (age >= 1) {
          stars.splice(i, 1);
          continue;
        }
        st.x += st.vx;
        st.y += st.vy;
        const alpha = Math.sin(age * Math.PI) * 0.95;

        ctx.save();
        const grad = ctx.createLinearGradient(st.x, st.y, st.x - st.vx * 12, st.y - st.vy * 12);
        grad.addColorStop(0, `rgba(${pal.cyan}, ${alpha})`);
        grad.addColorStop(0.4, `rgba(${pal.pink}, ${alpha * 0.6})`);
        grad.addColorStop(1, `rgba(${pal.cyan}, 0)`);
        ctx.strokeStyle = grad;
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(st.x, st.y);
        ctx.lineTo(st.x - st.vx * 12, st.y - st.vy * 12);
        ctx.stroke();
        ctx.restore();
      }

      if (!reducedMotion) {
        rafId = requestAnimationFrame(draw);
      }
    }

    let rafId = 0;
    resize();

    if (reducedMotion) {
      draw(0);
    } else {
      rafId = requestAnimationFrame(draw);
    }

    window.addEventListener('resize', () => {
      resize();
      if (reducedMotion) draw(0);
    });

    window.addEventListener(
      'mousemove',
      (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
        mouse.active = true;
      },
      { passive: true },
    );

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    document.addEventListener('click', (e) => {
      if (reducedMotion) return;
      const target = e.target;
      if (
        target instanceof Element &&
        target.closest('a, button, input, select, textarea, .prose-cyber, .hud-panel, .cyber-card, header')
      ) {
        return;
      }
      slashes.push({
        x: e.clientX,
        y: e.clientY,
        angle: -0.35 + (Math.random() - 0.5) * 0.5,
        len: 75 + Math.random() * 55,
        curve: (Math.random() - 0.5) * 28,
        born: performance.now(),
        life: 340,
      });
    });

    window.addEventListener('lucy:shooting-stars', () => {
      if (reducedMotion) return;
      for (let i = 0; i < 14; i++) {
        setTimeout(() => {
          stars.push({
            x: width * (0.35 + Math.random() * 0.65),
            y: height * (0.04 + Math.random() * 0.35),
            vx: -(6 + Math.random() * 5),
            vy: 2.5 + Math.random() * 2.5,
            born: performance.now(),
            life: 1100 + Math.random() * 600,
          });
        }, i * 210);
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (reducedMotion) return;
      if (document.hidden && rafId) {
        cancelAnimationFrame(rafId);
        rafId = 0;
      } else if (!document.hidden && !rafId) {
        rafId = requestAnimationFrame(draw);
      }
    });
  })();
</script>
