---
import type { CollectionEntry } from 'astro:content';
import { UI } from '../config/site';
import { formatDate, getReadingTime } from '../utils/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  enableTagFilter?: boolean;
}

const { post, enableTagFilter = false } = Astro.props;
const { title, description, pubDate, lang, category, tags, cover, ctf, difficulty } = post.data;
const readMin = getReadingTime(post.body);
const href = `/posts/${post.id}/`;

let hash = 0x811c9dc5;
for (let i = 0; i < post.id.length; i++) {
  hash ^= post.id.charCodeAt(i);
  hash = Math.imul(hash, 0x01000193);
}
const sigHex = '0x' + (hash >>> 0).toString(16).toUpperCase().padStart(8, '0');
const isWriteup = category === 'writeup';
---

<article
  class="cyber-card group flex h-full flex-col"
  data-post-card
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-lang={lang}
  data-category={category}
  data-tags={tags.map((t) => t.toLowerCase()).join(',')}
>

  <div
    class="h-[2px] w-full"
    style={isWriteup
      ? 'background: linear-gradient(90deg, var(--yellow), var(--pink), transparent);'
      : 'background: linear-gradient(90deg, var(--cyan), var(--pink), transparent);'}
  ></div>

  <a
    href={href}
    class="relative block aspect-video w-full shrink-0 overflow-hidden border-b"
    style="border-color: var(--border-subtle);"
  >
    {
      cover ? (
        <img
          src={cover}
          alt={title}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="relative flex h-full w-full flex-col justify-between overflow-hidden p-4 font-mono"
          style="background: radial-gradient(circle at 85% 20%, var(--pink-soft), transparent 55%), linear-gradient(145deg, var(--surface-2) 0%, var(--code-bg) 100%);"
        >
          <div
            class="pointer-events-none absolute inset-0 opacity-40"
            style="background-image: linear-gradient(to right, var(--border-subtle) 1px, transparent 1px), linear-gradient(to bottom, var(--border-subtle) 1px, transparent 1px); background-size: 20px 20px;"
          />
          <div class="relative flex items-center justify-between text-[0.68rem]">
            <span
              class="chamfer-sm px-2 py-0.5 font-bold uppercase tracking-wider"
              style={isWriteup
                ? 'background: var(--yellow); color: var(--yellow-ink);'
                : 'background: var(--cyan); color: #07080f;'}
            >
              {isWriteup ? 'WRITEUP' : 'ARTICLE'}
            </span>
            <span style="color: var(--cyan);">{sigHex}</span>
          </div>

          <div class="relative mt-auto">
            {ctf && (
              <div class="mb-1 text-xs font-semibold" style="color: var(--pink);">
                {ctf}
                {difficulty ? ` // ${difficulty}` : ''}
              </div>
            )}
            <div class="truncate text-[0.72rem]" style="color: var(--text-muted);">
              &gt; /logs/{post.id}
            </div>
          </div>
        </div>
      )
    }
  </a>

  <div class="flex min-h-0 flex-1 flex-col gap-3 p-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="line-clamp-2 text-base font-bold leading-snug tracking-tight">
        <a
          href={href}
          class="transition-colors group-hover:text-[var(--cyan)]"
          style="color: var(--text);"
        >
          {title}
        </a>
      </h2>
      <span
        class="mt-0.5 shrink-0 border px-1.5 py-0.5 font-mono text-[0.65rem] font-bold uppercase"
        style="border-color: var(--pink); color: var(--pink); background: var(--pink-soft);"
      >
        {lang}
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs" style="color: var(--text-muted);">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      <span>
        {readMin}{' '}
        <span data-lang-only="vi">{UI.vi.minRead}</span>
        <span data-lang-only="en">{UI.en.minRead}</span>
      </span>
    </div>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) =>
            enableTagFilter ? (
              <button
                type="button"
                data-filter-tag={tag.toLowerCase()}
                class="cursor-pointer border px-2 py-0.5 font-mono text-[0.7rem] font-medium transition-colors hover:border-[var(--cyan)] hover:bg-[var(--cyan)] hover:text-[#07080f]"
                style="border-color: var(--border); background: var(--cyan-soft); color: var(--accent-text);"
              >
                #{tag}
              </button>
            ) : (
              <a
                href={`/posts/?tag=${encodeURIComponent(tag.toLowerCase())}`}
                class="border px-2 py-0.5 font-mono text-[0.7rem] font-medium transition-colors hover:border-[var(--cyan)] hover:bg-[var(--cyan)] hover:text-[#07080f]"
                style="border-color: var(--border); background: var(--cyan-soft); color: var(--accent-text);"
              >
                #{tag}
              </a>
            ),
          )}
        </div>
      )
    }

    <p class="line-clamp-3 flex-1 text-sm leading-relaxed" style="color: var(--text-muted);">
      {description}
    </p>

    <div class="mt-auto pt-2">
      <a
        href={href}
        class="chamfer-sm inline-flex h-9 items-center gap-2 border px-4 font-mono text-xs font-bold tracking-wider transition-colors hover:bg-[var(--cyan)] hover:text-[#07080f]"
        style="border-color: var(--cyan); color: var(--cyan);"
      >
        <span data-lang-only="vi">{UI.vi.readMore}</span>
        <span data-lang-only="en">{UI.en.readMore}</span>
      </a>
    </div>
  </div>
</article>
