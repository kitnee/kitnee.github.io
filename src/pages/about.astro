---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, UI } from '../config/site';
---

<BaseLayout title={`// ABOUT — ${SITE.handle.toUpperCase()}`} description={SITE.description.vi}>
  <div class="mx-auto mt-8 max-w-6xl space-y-6 px-4 pb-12">

    <div>
      <div class="flex items-center gap-4">
        <h1 class="font-display flex items-center gap-2 text-3xl font-extrabold tracking-widest sm:text-4xl">
          <span style="color: var(--pink);">//</span>
          <span style="color: var(--text);">ABOUT_ME</span>
        </h1>
        <div class="monowire-line h-[2px] flex-1" />
        <span class="hazard-stripe hidden h-3 w-16 sm:inline-block"></span>
      </div>
      <p class="mt-2 font-mono text-xs sm:text-sm" style="color: var(--text-muted);">
        <span data-lang-only="vi">{UI.vi.aboutSub}</span>
        <span data-lang-only="en">{UI.en.aboutSub}</span>
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

      <section class="hud-panel p-6 sm:p-8 lg:col-span-7">
        <div class="mb-4 flex items-center justify-between border-b pb-3 font-mono text-xs" style="border-color: var(--border-subtle);">
          <span style="color: var(--cyan);">// OPERATOR_PROFILE</span>
          <span style="color: var(--pink);">{SITE.handle.toUpperCase()}</span>
        </div>

        <div class="space-y-3 text-sm leading-relaxed sm:text-base" style="color: var(--text-muted);">
          <div data-lang-only="vi" class="space-y-3">
            {
              SITE.about.intro.vi.map((p, idx) => (
                <p style={idx === 0 ? 'color: var(--text); font-weight: 600;' : undefined}>{p}</p>
              ))
            }
          </div>
          <div data-lang-only="en" class="space-y-3">
            {
              SITE.about.intro.en.map((p, idx) => (
                <p style={idx === 0 ? 'color: var(--text); font-weight: 600;' : undefined}>{p}</p>
              ))
            }
          </div>
        </div>
      </section>

      <aside class="hud-panel flex flex-col justify-between gap-6 p-6 sm:p-8 lg:col-span-5">
        <div>
          <h2 class="font-mono text-xs tracking-widest" style="color: var(--cyan);">
            // {UI.en.focusTitle}
          </h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              SITE.about.focus.map((skill) => (
                <span
                  class="chamfer-sm border px-3 py-1 font-mono text-xs"
                  style="border-color: var(--border); background: var(--cyan-soft); color: var(--text);"
                >
                  {skill}
                </span>
              ))
            }
          </div>
        </div>

        <div class="border-t pt-5" style="border-color: var(--border-subtle);">
          <h2 class="font-mono text-xs tracking-widest" style="color: var(--pink);">
            // {UI.en.interestsTitle}
          </h2>
          <ul data-lang-only="vi" class="mt-3 space-y-2 text-sm" style="color: var(--text-muted);">
            {
              SITE.about.interests.vi.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0" style="background: var(--yellow);"></span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <ul data-lang-only="en" class="mt-3 space-y-2 text-sm" style="color: var(--text-muted);">
            {
              SITE.about.interests.en.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0" style="background: var(--yellow);"></span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

      <section class="hud-panel p-6 sm:p-8 lg:col-span-6">
        <h2 class="font-mono text-xs tracking-widest" style="color: var(--cyan);">
          // {UI.en.pathTitle}
        </h2>

        <ol class="mt-6">
          {
            SITE.timeline.map((item, idx) => (
              <li class="flex gap-4">
                <div class="flex flex-col items-center">
                  <span
                    class="mt-1.5 h-2.5 w-2.5 shrink-0"
                    style="background: var(--pink); box-shadow: 0 0 8px var(--pink);"
                  />
                  {idx < SITE.timeline.length - 1 && (
                    <span class="mt-1 w-px flex-1" style="background: var(--border-subtle);" />
                  )}
                </div>
                <div class={idx < SITE.timeline.length - 1 ? 'pb-6' : ''}>
                  <p class="font-mono text-xs" style="color: var(--cyan);">
                    {item.period}
                  </p>
                  <h3 class="mt-1 text-base font-bold" style="color: var(--text);">
                    {item.org}
                  </h3>
                  <p class="mt-0.5 text-sm" style="color: var(--text);">
                    <span data-lang-only="vi">{item.role.vi}</span>
                    <span data-lang-only="en">{item.role.en}</span>
                  </p>
                  {item.note && (
                    <p class="mt-1.5 text-xs leading-relaxed" style="color: var(--text-muted);">
                      <span data-lang-only="vi">{item.note.vi}</span>
                      <span data-lang-only="en">{item.note.en}</span>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="hud-panel p-6 sm:p-8 lg:col-span-6">
        <h2 class="font-mono text-xs tracking-widest" style="color: var(--pink);">
          // {UI.en.achievementsTitle}
        </h2>

        <div class="mt-6 space-y-4">
          {
            SITE.achievements.map((ach) => (
              <div
                class="border p-4"
                style="border-color: var(--border-subtle); background: var(--surface-solid);"
              >
                <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
                  <span style="color: var(--cyan);">{ach.year}</span>
                  <span
                    class="chamfer-sm px-2 py-0.5 font-bold"
                    style="background: var(--yellow); color: var(--yellow-ink);"
                  >
                    {ach.rank}
                  </span>
                </div>
                <h3 class="mt-2 text-base font-bold" style="color: var(--text);">
                  {ach.title}
                </h3>
                {ach.detail && (
                  <p class="mt-1 text-xs leading-relaxed" style="color: var(--text-muted);">
                    <span data-lang-only="vi">{ach.detail.vi}</span>
                    <span data-lang-only="en">{ach.detail.en}</span>
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
