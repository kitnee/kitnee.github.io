---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, UI } from '../../config/site';
import { sortPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = sortPosts(await getCollection('posts'));

  const defs = [
    {
      group: 'sherlocks',
      title: 'HTB // SHERLOCKS',
      subVi: 'Danh sách các bài điều tra DFIR / Incident Response trên HackTheBox Sherlocks.',
      subEn: 'HackTheBox Sherlocks DFIR & Incident Response writeups.',
      posts: allPosts.filter((p) => p.data.ctf === 'HTB Sherlock'),
    },
    {
      group: 'medium',
      title: 'HTB // FORENSICS_MEDIUM',
      subVi: 'Danh sách các bài HTB Forensics mức Medium.',
      subEn: 'Medium-difficulty HackTheBox Forensics challenge writeups.',
      posts: allPosts.filter((p) => p.data.ctf === 'HTB Forensics' && p.data.difficulty === 'Medium'),
    },
    {
      group: 'easy',
      title: 'HTB // FORENSICS_EASY',
      subVi: 'Danh sách các bài HTB Forensics mức Easy.',
      subEn: 'Easy-difficulty HackTheBox Forensics challenge writeups.',
      posts: allPosts.filter((p) => p.data.ctf === 'HTB Forensics' && p.data.difficulty === 'Easy'),
    },
    {
      group: 'very-easy',
      title: 'HTB // FORENSICS_VERY_EASY',
      subVi: 'Danh sách các bài HTB Forensics mức Very Easy.',
      subEn: 'Very Easy HackTheBox Forensics challenge writeups.',
      posts: allPosts.filter((p) => p.data.ctf === 'HTB Forensics' && p.data.difficulty === 'Very Easy'),
    },
  ];

  return defs.map((d) => ({
    params: { group: d.group },
    props: d,
  }));
}

const { group, title, subVi, subEn, posts } = Astro.props;
---

<BaseLayout title={`${title} — ${SITE.handle.toUpperCase()}`} description={subEn}>
  <div class="mx-auto mt-8 max-w-6xl px-4 pb-12">

    <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs" style="color: var(--text-muted);">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-[var(--cyan)]">HOME</a></li>
        <li style="color: var(--pink);">/</li>
        <li><a href="/htb/" class="transition-colors hover:text-[var(--cyan)]">HTB</a></li>
        <li style="color: var(--pink);">/</li>
        <li class="uppercase" style="color: var(--text);">{group}</li>
      </ol>
    </nav>

    <div class="mb-6">
      <div class="flex items-center gap-4">
        <h1 class="font-display flex items-center gap-2 text-2xl font-extrabold tracking-widest sm:text-3xl">
          <span style="color: var(--pink);">//</span>
          <span style="color: var(--text);">{title.replace('HTB // ', '')}</span>
        </h1>
        <div class="monowire-line h-[2px] flex-1" />
        <span class="font-mono text-xs" style="color: var(--cyan);">{posts.length} LOGS</span>
      </div>
      <p class="mt-2 font-mono text-xs sm:text-sm" style="color: var(--text-muted);">
        <span data-lang-only="vi">{subVi}</span>
        <span data-lang-only="en">{subEn}</span>
      </p>
    </div>

    <div class="hud-panel mb-7 p-4">
      <div class="relative">
        <svg
          class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2"
          style="color: var(--cyan);"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.34-4.34" />
        </svg>
        <input
          id="htb-group-search"
          type="search"
          placeholder={UI.vi.filterPlaceholder}
          data-placeholder-vi={UI.vi.filterPlaceholder}
          data-placeholder-en={UI.en.filterPlaceholder}
          class="w-full border py-2 pr-3 pl-9 font-mono text-sm outline-none focus:border-[var(--cyan)]"
          style="background: var(--surface-solid); border-color: var(--border-subtle); color: var(--text);"
        />
      </div>
    </div>

    <div id="htb-group-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <div id="htb-group-empty" class="hud-panel hidden py-12 text-center">
      <p class="font-mono text-sm" style="color: var(--text-muted);">
        <span data-lang-only="vi">{UI.vi.noPosts}</span>
        <span data-lang-only="en">{UI.en.noPosts}</span>
      </p>
    </div>

    <div id="htb-group-pagination" class="mt-10 hidden items-center justify-center gap-3 font-mono text-xs">
      <button
        id="htb-page-prev"
        type="button"
        class="chamfer-sm cursor-pointer border px-3.5 py-2 transition-colors hover:border-[var(--cyan)] hover:text-[var(--cyan)] disabled:cursor-not-allowed disabled:opacity-40"
        style="background: var(--surface); border-color: var(--border-subtle); color: var(--text);"
      >
        <span data-lang-only="vi">{UI.vi.prev}</span>
        <span data-lang-only="en">{UI.en.prev}</span>
      </button>
      <span id="htb-page-indicator" style="color: var(--cyan);">1 / 1</span>
      <button
        id="htb-page-next"
        type="button"
        class="chamfer-sm cursor-pointer border px-3.5 py-2 transition-colors hover:border-[var(--cyan)] hover:text-[var(--cyan)] disabled:cursor-not-allowed disabled:opacity-40"
        style="background: var(--surface); border-color: var(--border-subtle); color: var(--text);"
      >
        <span data-lang-only="vi">{UI.vi.next}</span>
        <span data-lang-only="en">{UI.en.next}</span>
      </button>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const PAGE_SIZE = 12;
    const input = document.getElementById('htb-group-search');
    const cards = Array.from(document.querySelectorAll('#htb-group-grid [data-post-card]'));
    const emptyEl = document.getElementById('htb-group-empty');
    const pager = document.getElementById('htb-group-pagination');
    const prevBtn = document.getElementById('htb-page-prev');
    const nextBtn = document.getElementById('htb-page-next');
    const indicator = document.getElementById('htb-page-indicator');

    let query = '';
    let page = 1;

    function syncPlaceholder() {
      const uiLang = document.documentElement.dataset.uiLang === 'en' ? 'en' : 'vi';
      if (input) input.placeholder = input.getAttribute(`data-placeholder-${uiLang}`) || '';
    }

    function render() {
      const q = query.trim().toLowerCase();
      const matched = cards.filter((c) => {
        if (!q) return true;
        return (
          (c.dataset.title || '').includes(q) ||
          (c.dataset.description || '').includes(q) ||
          (c.dataset.tags || '').includes(q)
        );
      });

      const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
      if (page > totalPages) page = totalPages;

      const start = (page - 1) * PAGE_SIZE;
      const pageSet = new Set(matched.slice(start, start + PAGE_SIZE));

      cards.forEach((c) => c.classList.toggle('hidden', !pageSet.has(c)));
      if (emptyEl) emptyEl.classList.toggle('hidden', matched.length > 0);

      if (pager && indicator && prevBtn && nextBtn) {
        const show = totalPages > 1;
        pager.classList.toggle('hidden', !show);
        pager.classList.toggle('flex', show);
        indicator.textContent = `${page} / ${totalPages}`;
        prevBtn.disabled = page <= 1;
        nextBtn.disabled = page >= totalPages;
      }
    }

    if (input) {
      input.addEventListener('input', () => {
        query = input.value;
        page = 1;
        render();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (page > 1) {
          page--;
          render();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        page++;
        render();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    window.addEventListener('kitnee:lang-change', syncPlaceholder);
    syncPlaceholder();
    render();
  })();
</script>
