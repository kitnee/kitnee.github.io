---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, UI } from '../../config/site';
import { formatDate, getReadingTime, sortPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));
  return posts.map((post, idx) => ({
    params: { slug: post.id },
    props: {
      post,
      newerPost: idx > 0 ? posts[idx - 1] : null,
      olderPost: idx < posts.length - 1 ? posts[idx + 1] : null,
    },
  }));
}

const { post, newerPost, olderPost } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, lang, category, tags, ctf, difficulty, cover } =
  post.data;
const readMin = getReadingTime(post.body);

const h2Only = headings.filter((h) => h.depth === 2);
const tocHeadings = h2Only.length >= 6 ? h2Only : headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const isWriteup = category === 'writeup';
const isHtb = (ctf || '').startsWith('HTB');
const htbGroupSlug =
  ctf === 'HTB Sherlock'
    ? 'sherlocks'
    : difficulty === 'Medium'
      ? 'medium'
      : difficulty === 'Easy'
        ? 'easy'
        : 'very-easy';
const htbGroupLabel =
  htbGroupSlug === 'sherlocks'
    ? 'SHERLOCKS'
    : htbGroupSlug === 'medium'
      ? 'MEDIUM'
      : htbGroupSlug === 'easy'
        ? 'EASY'
        : 'VERY_EASY';
---

<BaseLayout title={`${title} — ${SITE.handle.toUpperCase()}`} description={description} ogType="article">
  <div class="mx-auto mt-8 max-w-6xl px-4 pb-12">

    <nav aria-label="Breadcrumb" class="mb-5 font-mono text-xs" style="color: var(--text-muted);">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="transition-colors hover:text-[var(--cyan)]">HOME</a>
        </li>
        <li style="color: var(--pink);">/</li>
        {
          isHtb ? (
            <>
              <li>
                <a href="/htb/" class="transition-colors hover:text-[var(--cyan)]">HTB</a>
              </li>
              <li style="color: var(--pink);">/</li>
              <li>
                <a href={`/htb/${htbGroupSlug}/`} class="transition-colors hover:text-[var(--cyan)]">
                  {htbGroupLabel}
                </a>
              </li>
            </>
          ) : (
            <li>
              <a href="/posts/" class="transition-colors hover:text-[var(--cyan)]">POSTS</a>
            </li>
          )
        }
        <li style="color: var(--pink);">/</li>
        <li class="truncate" style="color: var(--text);">{title}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_230px]">

      <article class="hud-panel min-w-0 px-5 py-7 sm:px-9 sm:py-10">
        <header class="border-b pb-6" style="border-color: var(--border-subtle);">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <span
              class="chamfer-sm px-2.5 py-0.5 font-bold uppercase tracking-wider"
              style={isWriteup
                ? 'background: var(--yellow); color: var(--yellow-ink);'
                : 'background: var(--cyan); color: #07080f;'}
            >
              {category}
            </span>
            <span
              class="border px-2 py-0.5 font-bold uppercase"
              style="border-color: var(--pink); color: var(--pink); background: var(--pink-soft);"
            >
              {lang}
            </span>
            {ctf && (
              <span
                class="border px-2 py-0.5"
                style="border-color: var(--border-subtle); color: var(--cyan);"
              >
                {ctf}{difficulty ? ` // ${difficulty}` : ''}
              </span>
            )}
          </div>

          <h1
            class="selectable mt-4 text-2xl font-bold leading-tight sm:text-3xl"
            style="color: var(--text);"
          >
            {title}
          </h1>

          <p class="selectable mt-3 text-sm leading-relaxed sm:text-base" style="color: var(--text-muted);">
            {description}
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs" style="color: var(--text-muted);">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
            {updatedDate && <span>updated {formatDate(updatedDate, lang)}</span>}
            <span>
              {readMin}{' '}
              <span data-lang-only="vi">{UI.vi.minRead}</span>
              <span data-lang-only="en">{UI.en.minRead}</span>
            </span>
          </div>

          {
            tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a
                    href={`/posts/?tag=${encodeURIComponent(tag.toLowerCase())}`}
                    class="border px-2 py-0.5 font-mono text-xs font-medium transition-colors hover:bg-[var(--cyan)] hover:text-[#07080f]"
                    style="border-color: var(--border); background: var(--cyan-soft); color: var(--accent-text);"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        {
          cover && (
            <div class="mt-6 overflow-hidden border" style="border-color: var(--border-subtle);">
              <img src={cover} alt={title} class="max-h-96 w-full object-cover" />
            </div>
          )
        }

        <div class="prose-cyber mt-8 max-w-[72ch]">
          <Content />
        </div>

        <nav
          class="mt-12 grid grid-cols-1 gap-3 border-t pt-6 sm:grid-cols-2"
          style="border-color: var(--border-subtle);"
        >
          <div>
            {
              olderPost && (
                <a
                  href={`/posts/${olderPost.id}/`}
                  class="block border p-3.5 transition-colors hover:border-[var(--cyan)]"
                  style="border-color: var(--border-subtle);"
                >
                  <div class="font-mono text-[0.68rem]" style="color: var(--pink);">
                    &lt; <span data-lang-only="vi">{UI.vi.prevPost}</span>
                    <span data-lang-only="en">{UI.en.prevPost}</span>
                  </div>
                  <div class="mt-1 line-clamp-1 font-display text-sm font-bold" style="color: var(--text);">
                    {olderPost.data.title}
                  </div>
                </a>
              )
            }
          </div>
          <div>
            {
              newerPost && (
                <a
                  href={`/posts/${newerPost.id}/`}
                  class="block border p-3.5 text-left transition-colors hover:border-[var(--cyan)] sm:text-right"
                  style="border-color: var(--border-subtle);"
                >
                  <div class="font-mono text-[0.68rem]" style="color: var(--pink);">
                    <span data-lang-only="vi">{UI.vi.nextPost}</span>
                    <span data-lang-only="en">{UI.en.nextPost}</span> &gt;
                  </div>
                  <div class="mt-1 line-clamp-1 font-display text-sm font-bold" style="color: var(--text);">
                    {newerPost.data.title}
                  </div>
                </a>
              )
            }
          </div>
        </nav>
      </article>

      {
        tocHeadings.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <div class="hud-panel max-h-[calc(100vh-8rem)] overflow-y-auto p-4">
                <h2 class="font-mono text-xs font-bold tracking-wider" style="color: var(--cyan);">
                  // <span data-lang-only="vi">{UI.vi.toc}</span>
                  <span data-lang-only="en">{UI.en.toc}</span>
                </h2>
                <ul class="mt-3 space-y-2 font-mono text-xs">
                  {tocHeadings.map((h) => (
                    <li class={h.depth === 3 ? 'pl-3' : ''}>
                      <a
                        href={`#${h.slug}`}
                        class="block leading-snug transition-colors hover:text-[var(--cyan)]"
                        style="color: var(--text-muted);"
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const mermaidPres = Array.from(
      document.querySelectorAll('.prose-cyber pre.astro-code[data-language="mermaid"]'),
    );
    const mathPres = Array.from(
      new Set([
        ...document.querySelectorAll(
          '.prose-cyber pre.astro-code[data-language="math"], .prose-cyber pre.astro-code[data-language="latex"], .prose-cyber pre.astro-code[data-language="tex"]',
        ),
        ...Array.from(
          document.querySelectorAll(
            '.prose-cyber pre > code.language-math, .prose-cyber pre > code.language-latex, .prose-cyber pre > code.language-tex',
          ),
        )
          .map((c) => c.parentElement)
          .filter(Boolean),
      ]),
    );

    document.querySelectorAll('.prose-cyber pre.astro-code').forEach((pre) => {
      const langAttr = pre.getAttribute('data-language');
      if (langAttr === 'mermaid' || langAttr === 'math') return;
      if (pre.parentElement?.classList.contains('code-block-wrapper')) return;

      const lang = pre.getAttribute('data-language') || 'text';
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const label = document.createElement('span');
      label.textContent = lang;

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'code-copy-btn';
      copyBtn.textContent = 'COPY';

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          copyBtn.textContent = 'COPIED';
          setTimeout(() => {
            copyBtn.textContent = 'COPY';
          }, 1600);
        } catch {}
      });

      header.appendChild(label);
      header.appendChild(copyBtn);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });

    if (mermaidPres.length > 0) {

      let modal = document.getElementById('mermaid-fullscreen-modal');
      if (!modal) {
        modal = document.createElement('div');
        modal.id = 'mermaid-fullscreen-modal';
        modal.className = 'fixed inset-0 z-50 hidden flex-col bg-black/90 backdrop-blur-md';
        modal.innerHTML = `
          <div class="flex items-center justify-between border-b px-4 py-3 font-mono text-xs" style="border-color: var(--border-subtle); background: var(--surface-solid);">
            <span style="color: var(--cyan);">MERMAID_VIEWER // DRAG TO PAN · WHEEL TO ZOOM</span>
            <div class="flex items-center gap-2">
              <button type="button" data-m-zoom="-" class="border px-2.5 py-1 cursor-pointer hover:border-[var(--cyan)]" style="border-color: var(--border-subtle); color: var(--text);">-</button>
              <button type="button" data-m-zoom="reset" class="border px-2.5 py-1 cursor-pointer hover:border-[var(--cyan)]" style="border-color: var(--border-subtle); color: var(--cyan);">100%</button>
              <button type="button" data-m-zoom="+" class="border px-2.5 py-1 cursor-pointer hover:border-[var(--cyan)]" style="border-color: var(--border-subtle); color: var(--text);">+</button>
              <button type="button" data-m-close class="border px-3 py-1 cursor-pointer hover:border-[var(--pink)]" style="border-color: var(--pink); color: var(--pink);">CLOSE</button>
            </div>
          </div>
          <div id="mermaid-modal-viewport" class="relative flex-1 overflow-hidden flex items-center justify-center cursor-grab" style="touch-action: none;">
            <div id="mermaid-modal-stage" style="transform-origin: center center;"></div>
          </div>
        `;
        document.body.appendChild(modal);
      }

      function attachPanZoom(viewport, stage, zoomLabel) {
        let scale = 1;
        let tx = 0;
        let ty = 0;
        let dragging = false;
        let sx = 0;
        let sy = 0;

        function apply() {
          stage.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
          if (zoomLabel) zoomLabel.textContent = `${Math.round(scale * 100)}%`;
        }

        function fitInitial() {
          const svg = stage.querySelector('svg');
          if (!svg) return;
          const vb = svg.viewBox?.baseVal;
          const svgW = (vb && vb.width) || svg.getBoundingClientRect().width || 600;
          const svgH = (vb && vb.height) || svg.getBoundingClientRect().height || 300;
          const vpW = Math.max(200, viewport.clientWidth - 36);
          const vpH = Math.max(180, viewport.clientHeight - 36);
          const fitScale = Math.min(1, vpW / svgW, vpH / svgH);
          scale = Math.max(0.28, fitScale);
          tx = 0;
          ty = 0;
          apply();
        }

        viewport.addEventListener('pointerdown', (e) => {
          dragging = true;
          sx = e.clientX - tx;
          sy = e.clientY - ty;
          viewport.setPointerCapture(e.pointerId);
        });

        viewport.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          tx = e.clientX - sx;
          ty = e.clientY - sy;
          apply();
        });

        const endDrag = () => {
          dragging = false;
        };
        viewport.addEventListener('pointerup', endDrag);
        viewport.addEventListener('pointercancel', endDrag);

        viewport.addEventListener(
          'wheel',
          (e) => {
            if (!e.ctrlKey && viewport.id !== 'mermaid-modal-viewport') return;
            e.preventDefault();
            const delta = e.deltaY < 0 ? 1.15 : 0.87;
            scale = Math.max(0.35, Math.min(4.5, scale * delta));
            apply();
          },
          { passive: false },
        );

        return {
          zoomIn() {
            scale = Math.min(4.5, scale * 1.25);
            apply();
          },
          zoomOut() {
            scale = Math.max(0.35, scale * 0.8);
            apply();
          },
          reset() {
            fitInitial();
          },
        };
      }

      const modalViewport = document.getElementById('mermaid-modal-viewport');
      const modalStage = document.getElementById('mermaid-modal-stage');
      const modalResetBtn = modal.querySelector('[data-m-zoom="reset"]');
      const modalCtrl = modalViewport && modalStage ? attachPanZoom(modalViewport, modalStage, modalResetBtn) : null;

      modal.querySelector('[data-m-zoom="-"]')?.addEventListener('click', () => modalCtrl?.zoomOut());
      modal.querySelector('[data-m-zoom="+"]')?.addEventListener('click', () => modalCtrl?.zoomIn());
      modalResetBtn?.addEventListener('click', () => modalCtrl?.reset());
      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.classList.remove('overflow-hidden');
      };
      modal.querySelector('[data-m-close]')?.addEventListener('click', closeModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });

      const blocks = mermaidPres.map((pre) => {
        const source = pre.innerText.trim();
        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-wrapper';
        wrapper.dataset.mermaidSource = source;

        wrapper.innerHTML = `
          <div class="mermaid-toolbar">
            <span>mermaid // drag to pan · ctrl+wheel</span>
            <div class="mermaid-toolbar-actions">
              <button type="button" class="mermaid-btn" data-action="out">-</button>
              <button type="button" class="mermaid-btn" data-action="reset">100%</button>
              <button type="button" class="mermaid-btn" data-action="in">+</button>
              <button type="button" class="mermaid-btn" data-action="expand">EXPAND</button>
            </div>
          </div>
          <div class="mermaid-viewport">
            <div class="mermaid-stage"></div>
          </div>
        `;

        pre.replaceWith(wrapper);

        const viewport = wrapper.querySelector('.mermaid-viewport');
        const stage = wrapper.querySelector('.mermaid-stage');
        const resetBtn = wrapper.querySelector('[data-action="reset"]');
        const ctrl = attachPanZoom(viewport, stage, resetBtn);

        wrapper.querySelector('[data-action="in"]')?.addEventListener('click', () => ctrl.zoomIn());
        wrapper.querySelector('[data-action="out"]')?.addEventListener('click', () => ctrl.zoomOut());
        resetBtn?.addEventListener('click', () => ctrl.reset());
        wrapper.querySelector('[data-action="expand"]')?.addEventListener('click', () => {
          if (!modalStage) return;
          modalStage.innerHTML = stage.innerHTML;
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.classList.add('overflow-hidden');
          setTimeout(() => modalCtrl?.reset(), 20);
        });

        return { wrapper, stage, ctrl };
      });

      async function renderMermaidDiagrams() {
        try {
          if (document.fonts && document.fonts.ready) {
            await document.fonts.ready;
          }
          const { default: mermaid } = await import(
            'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
          );
          const isDark = document.documentElement.classList.contains('dark');
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: 'base',
            flowchart: {
              useMaxWidth: false,
              htmlLabels: true,
              nodeSpacing: 44,
              rankSpacing: 52,
              padding: 18,
              curve: 'basis',
            },
            themeVariables: isDark
              ? {
                  darkMode: true,
                  background: '#0a0c15',
                  mainBkg: '#161c33',
                  primaryColor: '#161c33',
                  primaryTextColor: '#f8fafc',
                  primaryBorderColor: '#00f0ff',
                  nodeBorder: '#00f0ff',
                  nodeTextColor: '#f8fafc',
                  textColor: '#f8fafc',
                  lineColor: '#ff2a85',
                  secondaryColor: '#1f1830',
                  secondaryTextColor: '#f8fafc',
                  secondaryBorderColor: '#ff2a85',
                  tertiaryColor: '#11162a',
                  tertiaryTextColor: '#f8fafc',
                  clusterBkg: '#101426',
                  clusterBorder: '#ff2a85',
                  edgeLabelBackground: '#0d101c',
                  fontFamily: 'Saira, Segoe UI, sans-serif',
                  fontSize: '15px',
                }
              : {
                  darkMode: false,
                  background: '#f1f3f9',
                  mainBkg: '#ffffff',
                  primaryColor: '#ffffff',
                  primaryTextColor: '#090b14',
                  primaryBorderColor: '#008ca8',
                  nodeBorder: '#008ca8',
                  nodeTextColor: '#090b14',
                  textColor: '#090b14',
                  lineColor: '#e0126b',
                  secondaryColor: '#eef1f8',
                  secondaryTextColor: '#090b14',
                  secondaryBorderColor: '#e0126b',
                  tertiaryColor: '#f6f7fb',
                  tertiaryTextColor: '#090b14',
                  clusterBkg: '#f8fafc',
                  clusterBorder: '#e0126b',
                  edgeLabelBackground: '#ffffff',
                  fontFamily: 'Saira, Segoe UI, sans-serif',
                  fontSize: '15px',
                },
          });

          function applyNodeAutoContrast(svgEl) {
            svgEl.querySelectorAll('.node').forEach((node) => {
              const shape = node.querySelector('rect, polygon, path, circle, ellipse');
              if (!shape) return;
              const fill = window.getComputedStyle(shape).fill || '';
              const m = fill.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
              if (!m) return;
              const lum = 0.299 * Number(m[1]) + 0.587 * Number(m[2]) + 0.114 * Number(m[3]);
              const ink = lum > 145 ? '#090b14' : '#f8fafc';
              node.querySelectorAll('.nodeLabel, span, p, div, text, tspan').forEach((el) => {
                el.style.color = ink;
                el.style.fill = ink;
              });
            });
          }

          for (let i = 0; i < blocks.length; i++) {
            const { wrapper, stage, ctrl } = blocks[i];
            const src = wrapper.dataset.mermaidSource || '';
            try {
              const { svg } = await mermaid.render(`mermaid-svg-${Date.now()}-${i}`, src);
              stage.innerHTML = svg;
              const svgEl = stage.querySelector('svg');
              if (svgEl) {
                svgEl.style.maxWidth = 'none';
                svgEl.removeAttribute('height');
                applyNodeAutoContrast(svgEl);
              }
              ctrl.reset();
            } catch {
              stage.innerHTML = `<pre class="text-xs text-[var(--pink)] overflow-x-auto p-3">${src.replace(/</g, '&lt;')}</pre>`;
            }
          }
        } catch {}
      }

      renderMermaidDiagrams();

      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          setTimeout(renderMermaidDiagrams, 40);
        });
      }
    }

    if (mathPres.length > 0) {
      const mathTargets = mathPres.map((pre) => {
        const latex = pre.innerText.trim();
        const box = document.createElement('div');
        box.className = 'math-block selectable';
        box.textContent = latex;
        pre.replaceWith(box);
        return { box, latex };
      });

      if (!document.querySelector('link[data-katex-css]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css';
        link.dataset.katexCss = 'true';
        document.head.appendChild(link);
      }

      import('https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.mjs')
        .then(({ default: katex }) => {
          mathTargets.forEach(({ box, latex }) => {
            try {
              katex.render(latex, box, {
                displayMode: true,
                throwOnError: false,
                strict: false,
              });
            } catch {}
          });
        })
        .catch(() => {});
    }
  })();
</script>
